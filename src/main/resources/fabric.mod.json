{
  "schemaVersion": 1,
  "id": "easyredstone",
  "version": "${version}",
  "name": "Easy Redstone",
  "description": "Place redstone, hoppers and more on containers without sneaking. Configurable. Toggle with keybind (H).",
  "authors": ["PilinHead", "ported"],
  "license": "CC0-1.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.easyhopper.EasyHopperMod"
    ]
  },
  "mixins": [
    "easyredstone.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
